{
    "lsp": {
        "slint": {
            "settings": {
                "slint": {
                    // Relative include paths resolve from the importing file's folder: "src/styles…" for the compiler's own lookups from the worktree root, then one entry per folder whose files import std-widgets.slint.
                    "includePaths": ["src/styles", "src/styles/slintcn", "../styles/slintcn", "../../../src/styles/slintcn"],
                    "libraryPaths": {
                        "slintcn": "src/components"
                    },
                    "preview": {
                        "style": "slintcn"
                    }
                }
            }
        }
    }
}
