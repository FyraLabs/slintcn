import { SlintcnPalette, SlintcnSizeSettings } from "styling.slint";
import { Button, ButtonVariant } from "button.slint";
import { FieldCard, FieldCardContent } from "_field-card.slint";


// input component
export component Input {
    in-out property <string> text <=> i-text-input.text;
    in property <string> placeholder-text;
    in property <bool> enabled <=> i-text-input.enabled;
    in property <bool> read-only <=> i-text-input.read-only;
    in property <InputType> input-type;
    in property <InputMethodHints> input-method-hints: {
        capitalization: root.input-type == InputType.password ? CapitalizationMode.none : CapitalizationMode.sentences,
        auto-correct: root.input-type != InputType.password,
        auto-complete: root.input-type != InputType.password,
    };
    in-out property <bool> password-visible: false;
    in property <bool> invalid;
    out property <bool> has-focus: i-text-input.has-focus;


    callback edited(text: string);
    callback accepted(text: string);

    min-width: 80px;
    min-height: 36px;
    max-height: 36px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: i-text-input;
    accessible-role: none;

    i-background := Rectangle {
        border-radius: SlintcnSizeSettings.radius-md;
        border-width: 1px;
        border-color: SlintcnPalette.input;
        background: transparent;
        clip: true;

        i-text-input := TextInput {
            x: 12px;
            y: 0;
            width: max(0px, parent.width - 12px - (root.input-type == InputType.password ? 72px : 12px));
            height: 100%;
            single-line: true;
            input-method-hints: root.input-method-hints;
            input-type: root.input-type == InputType.password && root.password-visible ? InputType.text : root.input-type;
            vertical-alignment: center;
            font-size: 14px;
            color: SlintcnPalette.foreground;
            accessible-label: root.accessible-label;
            accessible-description: root.accessible-description;

            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }

        if root.text == "" && root.placeholder-text != "": Text {
            x: i-text-input.x;
            y: i-text-input.y;
            width: i-text-input.width;
            height: i-text-input.height;
            text: root.placeholder-text;
            color: SlintcnPalette.muted-foreground;
            font-size: 14px;
            vertical-alignment: center;
        }

        if root.input-type == InputType.password: Button {
            x: parent.width - self.width - 4px;
            y: (parent.height - self.height) / 2;
            width: 64px;
            text: root.password-visible ? "Hide" : "Show";
            variant: ButtonVariant.ghost;
            enabled: root.enabled;
            clicked => { root.password-visible = !root.password-visible; }
        }
    }
}

export component InputCard {
    in property <string> title <=> i-content.title;
    in property <string> description <=> i-content.description;
    in-out property <string> text <=> i-input.text;
    in property <string> placeholder-text <=> i-input.placeholder-text;
    in property <bool> enabled <=> i-input.enabled;
    in property <bool> read-only <=> i-input.read-only;
    in property <bool> invalid <=> i-input.invalid;
    in property <InputType> input-type <=> i-input.input-type;
    in property <InputMethodHints> input-method-hints <=> i-input.input-method-hints;
    in-out property <bool> password-visible <=> i-input.password-visible;
    out property <bool> has-focus: i-input.has-focus;

    callback edited(text: string);
    callback accepted(text: string);

    min-width: 160px;
    preferred-width: 384px;
    min-height: i-layout.min-height;
    preferred-height: i-layout.preferred-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: i-input;

    FieldCard {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        invalid: root.invalid;
        clickable: false;
        clicked => { i-input.focus(); }

        i-layout := VerticalLayout {
            padding: 12px;
            spacing: 12px;

            i-content := FieldCardContent {
                enabled: root.enabled;
                invalid: root.invalid;
            }

            i-input := Input {
                accessible-label: root.title;
                accessible-description: root.description;
                edited(text) => { root.edited(text); }
                accepted(text) => { root.accepted(text); }
            }
        }
    }
}
