import { GroupPosition, SlintcnPalette, SlintcnSizeSettings } from "styling.slint";
import { Button, ButtonVariant } from "button.slint";
export component Input {
    in-out property <string> text <=> i-text-input.text;
    in property <string> placeholder-text;
    in property <bool> enabled <=> i-text-input.enabled;
    in property <bool> read-only <=> i-text-input.read-only;
    in property <InputType> input-type;
    in property <InputMethodHints> input-method-hints: {
        capitalization: root.input-type == InputType.password ? CapitalizationMode.none : CapitalizationMode.sentences,
        auto-correct: root.input-type != InputType.password,
        auto-complete: root.input-type != InputType.password,
    };
    in-out property <bool> password-visible: false;
    in property <bool> invalid;
    in property <GroupPosition> group-position;
    in property <Orientation> group-orientation;
    out property <bool> has-focus: i-text-input.has-focus;

    callback edited(text: string);
    callback accepted(text: string);

    property <bool> joined-before: root.group-position == GroupPosition.middle || root.group-position == GroupPosition.last;
    property <bool> joined-after: root.group-position == GroupPosition.first || root.group-position == GroupPosition.middle;
    property <bool> group-vertical: root.group-orientation == Orientation.vertical;
    property <length> join-x: root.joined-before && !root.group-vertical ? 1px : 0;
    property <length> join-y: root.joined-before && root.group-vertical ? 1px : 0;

    min-width: 80px;
    min-height: 36px;
    max-height: 36px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: i-text-input;
    accessible-role: none;

    i-background := Rectangle {
        border-top-left-radius: root.joined-before ? 0 : SlintcnSizeSettings.radius-md;
        border-top-right-radius: (root.group-vertical ? root.joined-before : root.joined-after) ? 0 : SlintcnSizeSettings.radius-md;
        border-bottom-left-radius: (root.group-vertical ? root.joined-after : root.joined-before) ? 0 : SlintcnSizeSettings.radius-md;
        border-bottom-right-radius: root.joined-after ? 0 : SlintcnSizeSettings.radius-md;
        clip: true;

        // Extends past the clip on the leading side so grouped controls share one divider.
        i-border := Rectangle {
            x: -root.join-x;
            y: -root.join-y;
            width: parent.width + root.join-x;
            height: parent.height + root.join-y;
            border-top-left-radius: i-background.border-top-left-radius;
            border-top-right-radius: i-background.border-top-right-radius;
            border-bottom-left-radius: i-background.border-bottom-left-radius;
            border-bottom-right-radius: i-background.border-bottom-right-radius;
            border-width: 1px;
            border-color: SlintcnPalette.input;
        }

        i-text-input := TextInput {
            x: 12px;
            y: 0;
            width: max(0px, parent.width - 12px - (root.input-type == InputType.password ? 72px : 12px));
            height: 100%;
            single-line: true;
            input-method-hints: root.input-method-hints;
            input-type: root.input-type == InputType.password && root.password-visible ? InputType.text : root.input-type;
            vertical-alignment: center;
            font-size: 14px;
            color: SlintcnPalette.foreground.transparentize(root.enabled ? 0 : 0.5);
            accessible-label: root.accessible-label;
            accessible-description: root.accessible-description;

            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }

        if root.text == "" && root.placeholder-text != "": Text {
            x: i-text-input.x;
            y: i-text-input.y;
            width: i-text-input.width;
            height: i-text-input.height;
            text: root.placeholder-text;
            color: SlintcnPalette.muted-foreground.transparentize(root.enabled ? 0 : 0.5);
            font-size: 14px;
            vertical-alignment: center;
        }

        if root.input-type == InputType.password: Button {
            x: parent.width - self.width - 4px;
            y: (parent.height - self.height) / 2;
            width: 64px;
            text: root.password-visible ? "Hide" : "Show";
            variant: ButtonVariant.ghost;
            enabled: root.enabled;
            clicked => { root.password-visible = !root.password-visible; }
        }
    }
}
