import { SlintcnPalette } from "styling.slint";

export component Checkbox {
    in-out property <bool> checked;
    in property <bool> enabled <=> i-touch-area.enabled;
    in property <bool> invalid;
    out property <bool> has-focus: i-focus-scope.has-focus;

    callback toggled(checked: bool);

    private property <bool> dark: SlintcnPalette.color-scheme == ColorScheme.dark;
    private property <bool> keyboard-focus;
    private property <bool> focus-visible: root.has-focus && root.keyboard-focus;

    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: i-focus-scope;

    accessible-role: checkbox;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked <=> root.checked;
    accessible-action-default => { root.toggle(); }

    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    if root.focus-visible || root.invalid: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: 7px;
        border-width: 3px;
        border-color: root.invalid ? SlintcnPalette.destructive.transparentize(root.dark ? 0.6 : 0.8) : SlintcnPalette.ring.transparentize(0.5);
        opacity: root.enabled ? 1 : 0.5;
    }

    i-background := Rectangle {
        border-radius: 4px;
        border-width: 1px;
        border-color: root.focus-visible ? SlintcnPalette.ring : root.checked ? SlintcnPalette.primary : root.invalid ? SlintcnPalette.destructive.transparentize(root.dark ? 0.5 : 0) : SlintcnPalette.input;
        background: root.checked ? SlintcnPalette.primary : root.dark ? SlintcnPalette.input.transparentize(0.7) : transparent;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 2px;
        drop-shadow-color: #0000000d;
        opacity: root.enabled ? 1 : 0.5;

        if root.checked: Image {
            source: @image-url("_check.svg");
            width: 14px;
            height: 14px;
            colorize: SlintcnPalette.primary-foreground;
            accessible-role: none;
        }
    }

    i-touch-area := TouchArea {
        x: -12px;
        y: -8px;
        width: root.width + 24px;
        height: root.height + 16px;
        mouse-cursor: root.enabled ? pointer : not-allowed;
        clicked => {
            if root.enabled {
                root.keyboard-focus = false;
                i-focus-scope.focus();
                root.toggle();
            }
        }
    }

    i-focus-scope := FocusScope {
        x: 0;
        width: 0;
        enabled <=> root.enabled;

        focus-gained(reason) => {
            if reason != FocusReason.window-activation {
                root.keyboard-focus = reason == FocusReason.tab-navigation;
            }
        }

        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }
}
