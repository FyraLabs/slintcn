import { SlintcnSizeSettings } from "../styling.slint";
import { ComponentPalette } from "palette.slint";

export component Card {
    Rectangle {
        background: ComponentPalette.card;
        border-radius: SlintcnSizeSettings.radius-xl;
        border-width: 1px;
        border-color: ComponentPalette.border;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 3px;
        drop-shadow-color: #0000001a;
    }

    VerticalLayout {
        padding-top: 24px;
        padding-bottom: 24px;
        spacing: 24px;

        @children
    }
}

export component CardHeader inherits VerticalLayout {
    padding-left: 24px;
    padding-right: 24px;
    spacing: 8px;
}

export component CardTitle inherits Text {
    color: ComponentPalette.card-foreground;
    font-size: 16px;
    font-weight: 600;
}

export component CardDescription inherits Text {
    color: ComponentPalette.muted-foreground;
    font-size: 14px;
    wrap: word-wrap;
}

export component CardContent inherits VerticalLayout {
    padding-left: 24px;
    padding-right: 24px;
}

export component CardFooter inherits HorizontalLayout {
    padding-left: 24px;
    padding-right: 24px;
}
