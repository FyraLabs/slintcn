import { ScrollView } from "std-widgets.slint";
import { Alert, AlertVariant } from "@slintcn/alert.slint";
import { AlertDialog } from "@slintcn/alert-dialog.slint";
import { Button, ButtonSize, ButtonVariant } from "@slintcn/button.slint";
import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter } from "@slintcn/card.slint";
import { Dialog, DialogFooter } from "@slintcn/dialog.slint";
import { Input, InputCard } from "@slintcn/input.slint";
import { SlintcnPalette } from "@slintcn/styling.slint";
import { Switch, SwitchCard, SwitchSize } from "@slintcn/switch.slint";
import { Checkbox, CheckboxCard } from "@slintcn/checkbox.slint";

export component Gallery inherits Window {
    title: "slintcn gallery";
    preferred-width: 960px;
    preferred-height: 720px;
    background: SlintcnPalette.background;

    property <string> last-result;

    gallery-scroll := ScrollView {
        content-width: max(self.visible-width, gallery-content.min-width);
        content-height: gallery-content.preferred-height;

        gallery-content := VerticalLayout {
            padding: 32px;
            spacing: 32px;
            alignment: start;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Button { text: "Default"; }
                Button { text: "Secondary"; variant: ButtonVariant.secondary; }
                Button { text: "Destructive"; variant: ButtonVariant.destructive; }
                Button { text: "Outline"; variant: ButtonVariant.outline; }
                Button { text: "Ghost"; variant: ButtonVariant.ghost; }
                Button { text: "Link"; variant: ButtonVariant.link; }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                cross-axis-alignment: center;

                Button { text: "Small"; size: ButtonSize.sm; variant: ButtonVariant.outline; }
                Button { text: "Default"; variant: ButtonVariant.outline; }
                Button { text: "Large"; size: ButtonSize.lg; variant: ButtonVariant.outline; }
                Button { size: ButtonSize.icon; icon: @image-url("icons/plus.svg"); variant: ButtonVariant.outline; }
                Button { text: "Add"; icon: @image-url("icons/plus.svg"); }
                Button { text: "Disabled"; enabled: false; }
                Button {
                    text: SlintcnPalette.color-scheme == ColorScheme.dark ? "Light mode" : "Dark mode";
                    variant: ButtonVariant.outline;
                    clicked => {
                        SlintcnPalette.color-scheme = SlintcnPalette.color-scheme == ColorScheme.dark ? ColorScheme.light : ColorScheme.dark;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Input { width: 180px; placeholder-text: "Email"; }
                Input { width: 180px; text: "hello@fyralabs.com"; }
                Input { width: 180px; text: "hunter2"; input-type: InputType.password; }
                Input { width: 180px; placeholder-text: "Disabled"; enabled: false; }
                Input { width: 180px; text: "not-an-email"; invalid: true; }
            }

            HorizontalLayout {
                spacing: 24px;
                alignment: start;
                cross-axis-alignment: center;

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    airplane-mode := Switch {
                        accessible-label: "Airplane mode";
                        toggled(checked) => { root.last-result = checked ? "Airplane mode on" : "Airplane mode off"; }
                    }
                    Text { text: "Airplane mode"; color: SlintcnPalette.foreground; font-size: 14px; }
                }

                Switch { checked: true; accessible-label: "Checked"; }
                Switch { enabled: false; accessible-label: "Disabled"; }
                Switch { checked: true; enabled: false; accessible-label: "Disabled checked"; }
                Switch { invalid: true; accessible-label: "Invalid"; }
                Switch { checked: true; invalid: true; accessible-label: "Invalid checked"; }
                Switch { size: SwitchSize.sm; accessible-label: "Small"; }
                Switch { size: SwitchSize.sm; checked: true; accessible-label: "Small checked"; }
            }

            HorizontalLayout {
                spacing: 24px;
                alignment: start;
                cross-axis-alignment: center;

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    accept-terms := Checkbox {
                        accessible-label: "Accept terms and conditions";
                        toggled(checked) => { root.last-result = checked ? "Terms accepted" : "Terms unchecked"; }
                    }
                    Text { text: "Accept terms and conditions"; color: SlintcnPalette.foreground; font-size: 14px; }
                }

                Checkbox { checked: true; accessible-label: "Checked checkbox"; }
                Checkbox { enabled: false; accessible-label: "Disabled checkbox"; }
                Checkbox { checked: true; enabled: false; accessible-label: "Disabled checked checkbox"; }
                Checkbox { invalid: true; accessible-label: "Invalid checkbox"; }
                Checkbox { checked: true; invalid: true; accessible-label: "Invalid checked checkbox"; }
            }

            VerticalLayout {
                width: 384px;
                spacing: 24px;
                alignment: start;

                VerticalLayout {
                    spacing: 12px;

                    InputCard {
                        title: "Display name";
                        description: "This is how your name appears to others.";
                        placeholder-text: "Your name";
                        edited(text) => { root.last-result = "Display name: " + text; }
                    }
                    InputCard {
                        title: "Password";
                        description: "Use a strong, unique password.";
                        text: "hunter2";
                        input-type: InputType.password;
                    }
                }

                VerticalLayout {
                    spacing: 12px;

                    SwitchCard {
                        title: "Share across devices";
                        description: "Focus is shared across devices, and turns off when you leave the app.";
                        toggled(checked) => { root.last-result = checked ? "Sharing enabled" : "Sharing disabled"; }
                    }
                    SwitchCard {
                        title: "Enable notifications";
                        description: "Receive notifications when focus mode is enabled or disabled.";
                        checked: true;
                    }
                }

                VerticalLayout {
                    spacing: 12px;

                    CheckboxCard {
                        title: "Accept terms and conditions";
                        description: "By clicking this checkbox, you agree to the terms and conditions.";
                        toggled(checked) => { root.last-result = checked ? "Terms accepted" : "Terms unchecked"; }
                    }
                    CheckboxCard {
                        title: "Enable notifications";
                        description: "You can enable or disable notifications at any time.";
                        checked: true;
                    }
                }
            }

            HorizontalLayout {
                alignment: start;

                Card {
                    width: 360px;

                    CardHeader {
                        CardTitle { text: "Create project"; }
                        CardDescription { text: "Lorem Ipsum dolor sit amet consectetur adipiscing elit."; }
                    }

                    CardContent {
                        Text {
                            text: "Lorem Ipsum dolor sit amet consectetur adipiscing elit.";
                            color: SlintcnPalette.card-foreground;
                            wrap: word-wrap;
                        }
                    }

                    CardFooter {
                        spacing: 8px;
                        alignment: end;

                        Button { text: "Cancel"; variant: ButtonVariant.outline; }
                        Button { text: "Deploy"; }
                    }
                }
            }

            VerticalLayout {
                width: 480px;
                spacing: 16px;

                Alert {
                    icon: @image-url("icons/circle-check.svg");
                    title: "Success! Your changes have been saved";
                    description: "This is an alert with icon, title and description.";
                }

                Alert {
                    variant: AlertVariant.destructive;
                    icon: @image-url("icons/circle-alert.svg");
                    title: "Unable to process your payment.";
                    description: "Please verify your billing information and try again.";
                }

                Alert {
                    title: "No icon or description";
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                open-dialog := Button {
                    text: "Open dialog";
                    variant: ButtonVariant.outline;
                    clicked => { edit-dialog.show(); }
                }

                open-alert-dialog := Button {
                    text: "Delete account";
                    variant: ButtonVariant.destructive;
                    clicked => { delete-dialog.show(); }
                }

                result := Text {
                    text: root.last-result;
                    color: SlintcnPalette.muted-foreground;
                    vertical-alignment: center;
                }
            }
        }
    }

    Alert {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        width: 360px;
        icon: @image-url("icons/circle-check.svg");
        title: "Event has been created";
        description: "Sunday, December 03, 2023 at 9:00 AM";
    }

    edit-dialog := Dialog {
        title: "Edit profile";
        description: "Make changes to your profile here. Click save when you're done.";
        dismissed => { root.last-result = "Edit dialog dismissed"; }

        Text {
            text: "Dialog content goes here.";
            color: SlintcnPalette.foreground;
        }

        DialogFooter {
            Button {
                text: "Cancel";
                variant: ButtonVariant.outline;
                clicked => {
                    edit-dialog.close();
                    root.last-result = "Edit dialog cancelled";
                }
            }

            save-button := Button {
                text: "Save changes";
                clicked => {
                    edit-dialog.close();
                    root.last-result = "Saved";
                }
            }
        }
    }

    delete-dialog := AlertDialog {
        title: "Are you absolutely sure?";
        description: "This action cannot be undone. This will permanently delete your account and remove your data from our servers.";
        action-text: "Delete account";
        destructive: true;
        cancel => { root.last-result = "Delete cancelled"; }
        action => { root.last-result = "Account deleted"; }
    }
}
