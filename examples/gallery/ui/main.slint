import { ScrollArea } from "@slintcn/scroll-area.slint";
import { Alert, AlertVariant } from "@slintcn/alert.slint";
import { AlertDialog } from "@slintcn/alert-dialog.slint";
import { Button, ButtonSize, ButtonVariant } from "@slintcn/button.slint";
import { Dialog, DialogFooter } from "@slintcn/dialog.slint";
import { Tabs, TabsContent, TabsList } from "@slintcn/tabs.slint";
import { SlintcnPalette } from "@slintcn/styling.slint";
import { FieldExamples } from "fields.slint";
import { ButtonGroupExamples } from "button-groups.slint";
import { CardExamples } from "cards.slint";
import { MenuExamples } from "menus.slint";
import { LabelExamples } from "labels.slint";
import { ItemExamples } from "items.slint";
import { TabsExamples } from "tabs.slint";

export { ButtonGroupPreview } from "button-groups.slint";
export { CardPreview } from "cards.slint";
export { FieldPreview } from "fields.slint";
export { MenuPreview } from "menus.slint";
export { LabelPreview } from "labels.slint";
export { ItemPreview } from "items.slint";
export { TabsPreview } from "tabs.slint";

export component Gallery inherits Window {
    title: "slintcn gallery";
    preferred-width: 960px;
    preferred-height: 720px;
    background: SlintcnPalette.background;

    in-out property <ColorScheme> color-scheme <=> SlintcnPalette.color-scheme;
    in-out property <string> selected-section: "buttons";
    out property <string> last-result;

    gallery-scroll := ScrollArea {
        content-width: max(self.visible-width, gallery-content.min-width);
        content-height: gallery-content.preferred-height;

        gallery-content := VerticalLayout {
            padding: 32px;
            alignment: start;

            Tabs {
                TabsList {
                    tabs: [
                        { text:"Buttons", value:"buttons" },
                        { text:"Fields", value:"fields" },
                        { text:"Cards", value:"cards" },
                        { text:"Menus", value:"menus" },
                        { text:"Labels", value:"labels" },
                        { text:"Items", value:"items" },
                        { text:"Alerts", value:"alerts" },
                        { text:"Tabs", value:"tabs" },
                    ];
                    selected-value: root.selected-section;
                    changed(value) => {
                        root.selected-section = value;
                        gallery-scroll.content-y = 0;
                    }
                    navigation-group: "gallery-sections";
                }

                if root.selected-section == "buttons": TabsContent {
                    value: "buttons";
                    selected-value: root.selected-section;
                    spacing: 32px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Button { text: "Default"; }
                        Button { text: "Secondary"; variant: ButtonVariant.secondary; }
                        Button { text: "Destructive"; variant: ButtonVariant.destructive; }
                        Button { text: "Outline"; variant: ButtonVariant.outline; }
                        Button { text: "Ghost"; variant: ButtonVariant.ghost; }
                        Button { text: "Link"; variant: ButtonVariant.link; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        cross-axis-alignment: center;

                        Button { text: "Small"; size: ButtonSize.sm; variant: ButtonVariant.outline; }
                        Button { text: "Default"; variant: ButtonVariant.outline; }
                        Button { text: "Large"; size: ButtonSize.lg; variant: ButtonVariant.outline; }
                        Button { size: ButtonSize.icon; icon: @image-url("icons/plus.svg"); variant: ButtonVariant.outline; }
                        Button { text: "Add"; icon: @image-url("icons/plus.svg"); }
                        Button { text: "Disabled"; enabled: false; }
                        Button {
                            text: SlintcnPalette.color-scheme == ColorScheme.dark ? "Light mode" : "Dark mode";
                            variant: ButtonVariant.outline;
                            clicked => {
                                SlintcnPalette.color-scheme = SlintcnPalette.color-scheme == ColorScheme.dark ? ColorScheme.light : ColorScheme.dark;
                            }
                        }
                    }

                    ButtonGroupExamples {
                        clicked(message) => { root.last-result = message; }
                    }
                }

                if root.selected-section == "fields": TabsContent {
                    value: "fields";
                    selected-value: root.selected-section;
                    spacing: 32px;

                    FieldExamples {
                        width: 480px;
                        changed(message) => { root.last-result = message; }
                    }
                }

                if root.selected-section == "cards": TabsContent {
                    value: "cards";
                    selected-value: root.selected-section;
                    CardExamples {
                        clicked(message) => { root.last-result = message; }
                    }
                }

                if root.selected-section == "menus": TabsContent {
                    value: "menus";
                    selected-value: root.selected-section;
                    MenuExamples {
                        clicked(message) => { root.last-result = message; }
                    }
                }

                if root.selected-section == "labels": TabsContent {
                    value: "labels";
                    selected-value: root.selected-section;
                    LabelExamples {
                        changed(message) => { root.last-result = message; }
                    }
                }

                if root.selected-section == "items": TabsContent {
                    value: "items";
                    selected-value: root.selected-section;
                    ItemExamples {
                        clicked(message) => { root.last-result = message; }
                    }
                }

                if root.selected-section == "alerts": TabsContent {
                    value: "alerts";
                    selected-value: root.selected-section;
                    spacing: 32px;

                    VerticalLayout {
                        width: 480px;
                        spacing: 16px;

                        Alert {
                            icon: @image-url("icons/circle-check.svg");
                            title: "Success! Your changes have been saved";
                            description: "This is an alert with icon, title and description.";
                        }

                        Alert {
                            variant: AlertVariant.destructive;
                            icon: @image-url("icons/circle-alert.svg");
                            title: "Unable to process your payment.";
                            description: "Please verify your billing information and try again.";
                        }

                        Alert { title: "No icon or description"; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Button {
                            text: "Open dialog";
                            variant: ButtonVariant.outline;
                            clicked => { edit-dialog.show(); }
                        }

                        Button {
                            text: "Delete account";
                            variant: ButtonVariant.destructive;
                            clicked => { delete-dialog.show(); }
                        }

                        Text {
                            text: root.last-result;
                            color: SlintcnPalette.muted-foreground;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.selected-section == "tabs": TabsContent {
                    value: "tabs";
                    selected-value: root.selected-section;
                    // Definite width avoids a layout recursion in nested auto-width tabs.
                    TabsExamples { width: 620px; }
                }
            }

        }
    }

    if root.selected-section == "alerts": Alert {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        width: 360px;
        icon: @image-url("icons/circle-check.svg");
        title: "Event has been created";
        description: "Sunday, December 03, 2023 at 9:00 AM";
    }

    edit-dialog := Dialog {
        title: "Edit profile";
        description: "Make changes to your profile here. Click save when you're done.";
        dismissed => { root.last-result = "Edit dialog dismissed"; }

        Text {
            text: "Dialog content goes here.";
            color: SlintcnPalette.foreground;
        }

        DialogFooter {
            Button {
                text: "Cancel";
                variant: ButtonVariant.outline;
                clicked => {
                    edit-dialog.close();
                    root.last-result = "Edit dialog cancelled";
                }
            }

            Button {
                text: "Save changes";
                clicked => {
                    edit-dialog.close();
                    root.last-result = "Saved";
                }
            }
        }
    }

    delete-dialog := AlertDialog {
        title: "Are you absolutely sure?";
        description: "This action cannot be undone. This will permanently delete your account and remove your data from our servers.";
        action-text: "Delete account";
        destructive: true;
        cancel => { root.last-result = "Delete cancelled"; }
        action => { root.last-result = "Account deleted"; }
    }
}
